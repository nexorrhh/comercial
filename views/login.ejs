<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>Ingresar · Cotizaciones Cimomet</title>
  <link rel="stylesheet" href="/css/estilo.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-caja">
      <h1>Cotizaciones &amp; Indicadores ISO</h1>

      <% if (modo === 'email') { %>
        <form method="post" action="/login/continuar">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" required autofocus>
          <button type="submit">Continuar</button>
        </form>
      <% } else if (modo === 'crear-password') { %>
        <p class="meta" style="color:var(--text-secondary); font-size:0.85rem;">Todavía no tenés una contraseña propia para <strong><%= email %></strong>. Creá una para poder entrar de acá en adelante.</p>
        <form method="post" action="/login/crear-password">
          <input type="hidden" name="email" value="<%= email %>">
          <label for="password">Contraseña nueva</label>
          <input type="password" id="password" name="password" autocomplete="new-password" required autofocus minlength="8">
          <label for="confirmar">Repetir contraseña</label>
          <input type="password" id="confirmar" name="confirmar" autocomplete="new-password" required minlength="8">
          <button type="submit">Crear contraseña y entrar</button>
        </form>
        <p style="margin-top:0.75rem;"><a href="/login">Volver</a></p>
      <% } else { %>
        <form method="post" action="/login">
          <input type="hidden" name="email" value="<%= email %>">
          <p class="meta" style="color:var(--text-secondary); font-size:0.85rem;"><%= email %></p>
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required autofocus>
          <button type="submit">Ingresar</button>
        </form>
        <p style="margin-top:0.75rem;"><a href="/login">Usar otro email</a></p>
      <% } %>

      <% if (error) { %><p class="mensaje-error"><%= error %></p><% } %>
    </div>
  </div>
</body>
</html>
